rules_version = '2';

// EmPoster Firestore rules
//
// NOTE: The app uses Firebase anonymous auth, so rules cannot check the
// Patreon email of a request. Approval gating is enforced by the app
// (staff logs in with Patreon). These rules enforce the basic contract:
//   - anyone (anonymous) may create a submission, but only as "pending"
//   - only pending/approved/rejected submissions can be updated
//     (the app only calls updateStatus for admins)
//   - approved submissions are readable by everyone
//   - rejected/pending are readable by signed-in users (kept hidden from
//     the public Explore feed by the app itself)
service cloud.firestore {
  match /databases/{database}/documents {
    match /submissions/{docId} {
      allow read: if request.auth != null || resource.data.status == 'approved';
      allow create: if request.auth != null
                     && request.resource.data.status == 'pending';
      allow update: if request.auth != null
                     && request.resource.data.status in ['pending', 'approved', 'rejected'];
      allow delete: if false;
    }

    // Reserved for future server-side admin verification.
    match /admins/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}